<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product – Admin Panel</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span>🛍️</span>
                <span>Admin Panel</span>
            </div>
            <nav class="sidebar-nav">
                <a href="/admin" class="nav-item">📋 Dashboard</a>
                <a href="/admin/products/add" class="nav-item active">➕ Add Product</a>
                <a href="/admin/orders" class="nav-item">📦 Orders</a>
                <a href="/" class="nav-item" target="_blank">🌐 View Store</a>
                <a href="/logout" class="nav-item logout">🚪 Logout</a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="admin-content">

            <div class="admin-header">
                <h1>Add New Product</h1>
                <a href="/admin" class="btn-secondary">← Back to Dashboard</a>
            </div>

            <!-- Validation error message -->
            <% if (error) { %>
                <div class="alert-error"><%= error %></div>
            <% } %>

            <!-- Add Product Form -->
            <!-- enctype="multipart/form-data" is required for file uploads -->
            <div class="form-card">
                <form action="/admin/products/add" method="POST" enctype="multipart/form-data">

                    <!-- Product Name -->
                    <div class="form-group">
                        <label for="name">Product Name <span class="required">*</span></label>
                        <input type="text" id="name" name="name" placeholder="e.g. Gold Twisted Ring" required>
                    </div>

                    <!-- Description -->
                    <div class="form-group">
                        <label for="description">Description <span class="required">*</span></label>
                        <textarea id="description" name="description" rows="3" placeholder="Short product description..." required></textarea>
                    </div>

                    <!-- Price and Stock side by side -->
                    <div class="form-row">
                        <div class="form-group">
                            <label for="price">Price (Rs.) <span class="required">*</span></label>
                            <input type="number" id="price" name="price" placeholder="e.g. 1500" min="1" required>
                        </div>
                        <div class="form-group">
                            <label for="stock">Stock <span class="required">*</span></label>
                            <input type="number" id="stock" name="stock" placeholder="e.g. 10" min="0" required>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="form-group">
                        <label for="category">Category <span class="required">*</span></label>
                        <select id="category" name="category" required>
                            <option value="">-- Select Category --</option>
                            <option value="Rings">Rings</option>
                            <option value="Necklaces">Necklaces</option>
                            <option value="Bracelets">Bracelets</option>
                            <option value="Earrings">Earrings</option>
                            <option value="Hair Accessories">Hair Accessories</option>
                        </select>
                    </div>

                    <!-- Image Upload -->
                    <div class="form-group">
                        <label for="image">Product Image</label>
                        <input type="file" id="image" name="image" accept="image/*">
                        <small class="form-hint">Accepted formats: JPG, PNG, WEBP, GIF. Max size: 5MB. Leave empty to add image later.</small>
                    </div>

                    <!-- Featured Sections -->
                    <div class="form-group">
                        <label>Feature this product in</label>
                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="isNewArrival" value="on">
                                ✨ New Arrivals
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="isBestSelling" value="on">
                                🔥 Best Selling Items
                            </label>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="form-actions">
                        <button type="submit" class="btn-submit">Save Product</button>
                        <a href="/admin" class="btn-cancel">Cancel</a>
                    </div>

                </form>
            </div>

        </main>
    </div>

</body>
</html>
