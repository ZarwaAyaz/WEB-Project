<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard – Honey, I'm home Accessories</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <!-- ===== Admin Sidebar ===== -->
    <div class="admin-wrapper">

        <aside class="sidebar">
            <div class="sidebar-brand">
                <span>🛍️</span>
                <span>Admin Panel</span>
            </div>
            <nav class="sidebar-nav">
                <a href="/admin" class="nav-item active">📋 Dashboard</a>
                <a href="/admin/products/add" class="nav-item">➕ Add Product</a>
                <a href="/admin/orders" class="nav-item">📦 Orders</a>
                <a href="/" class="nav-item" target="_blank">🌐 View Store</a>
                <a href="/logout" class="nav-item logout">🚪 Logout</a>
            </nav>
        </aside>

        <!-- ===== Main Content ===== -->
        <main class="admin-content">

            <!-- Page Title -->
            <div class="admin-header">
                <h1>Product Dashboard</h1>
                <a href="/admin/products/add" class="btn-add">+ Add New Product</a>
            </div>

            <!-- Success Message (from connect-flash, set after add/edit/delete) -->
            <% if (success && success.length > 0) { %>
                <div class="alert-success"><%= success[0] %></div>
            <% } %>

            <!-- Stats Summary -->
            <div class="stats-row">
                <div class="stat-card">
                    <span class="stat-number"><%= products.length %></span>
                    <span class="stat-label">Total Products</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number"><%= products.filter(p => p.stock > 0).length %></span>
                    <span class="stat-label">In Stock</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number"><%= products.filter(p => p.stock === 0).length %></span>
                    <span class="stat-label">Out of Stock</span>
                </div>
            </div>

            <!-- ===== Products Table ===== -->
            <div class="table-container">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price (Rs.)</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (products.length === 0) { %>
                            <tr>
                                <td colspan="6" style="text-align:center; padding: 30px; color: #888;">
                                    No products found. <a href="/admin/products/add">Add the first one!</a>
                                </td>
                            </tr>
                        <% } else { %>
                            <% products.forEach(product => { %>
                                <tr>
                                    <!-- Product Image -->
                                    <td>
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="<%= product.name %>" class="table-img">
                                        <% } else { %>
                                            <div class="table-img-placeholder"><%= product.category.charAt(0) %></div>
                                        <% } %>
                                    </td>

                                    <!-- Name -->
                                    <td class="product-name-cell"><%= product.name %></td>

                                    <!-- Category -->
                                    <td><span class="category-badge"><%= product.category %></span></td>

                                    <!-- Price -->
                                    <td class="price-cell">Rs. <%= product.price.toLocaleString() %></td>

                                    <!-- Stock -->
                                    <td>
                                        <% if (product.stock === 0) { %>
                                            <span class="badge-sold-out">Sold Out</span>
                                        <% } else { %>
                                            <span class="badge-in-stock"><%= product.stock %> left</span>
                                        <% } %>
                                    </td>

                                    <!-- Edit / Delete Actions -->
                                    <td class="actions-cell">
                                        <!-- Edit Button -->
                                        <a href="/admin/products/edit/<%= product._id %>" class="btn-edit">Edit</a>

                                        <!-- Delete Button — uses a form + JS confirmation popup -->
                                        <form
                                            action="/admin/products/delete/<%= product._id %>"
                                            method="POST"
                                            style="display:inline;"
                                            onsubmit="return confirm('Are you sure you want to delete \'<%= product.name %>\'? This action cannot be undone.');"
                                        >
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </main>
    </div>

</body>
</html>
