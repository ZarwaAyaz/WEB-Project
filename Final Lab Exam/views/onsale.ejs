<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>On Sale - Honey, I'm home Accessories.</title>
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Inline styles for the pagination controls so no extra CSS file is needed -->
    <style>
        /* ---- Pagination Controls ---- */
        .onsale-pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin: 40px 0 60px;
        }

        .onsale-pagination .page-btn {
            display: inline-block;
            padding: 10px 24px;
            background-color: #1a1a1a;
            color: #fff;
            border: none;
            cursor: pointer;
            font-size: 14px;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
            text-decoration: none;
        }

        .onsale-pagination .page-btn:hover {
            background-color: #c084a8;
        }

        /* Page indicator text — e.g. "Page 1 of 2" */
        .onsale-pagination #page-indicator {
            font-size: 14px;
            color: #555;
            min-width: 90px;
            text-align: center;
        }

        /* Sale badge shown on every card on this page */
        .badge.on-sale {
            background-color: #e53935;
            color: #fff;
        }

        /* Price display: original (struck-through) + discounted side by side */
        .price-was {
            text-decoration: line-through;
            color: #999;
            font-size: 13px;
            margin-right: 6px;
        }

        .price-now {
            color: #e53935;
            font-weight: 700;
            font-size: 15px;
        }
    </style>
</head>
<body>
    <%- include('header') %>

    <!-- Page Header — reuses .page-header class from styles.css -->
    <section class="page-header">
        <h2 class="page-title">🔥 On Sale</h2>
        <p class="page-subtitle">
            Limited-time deals &mdash; <%= products.length %> item<%= products.length !== 1 ? 's' : '' %> on sale
        </p>
    </section>

    <div class="products-page-container">

        <% if (products.length === 0) { %>
            <!-- Empty state -->
            <div class="no-products">
                <p>No on-sale products at the moment. Check back soon!</p>
                <a href="/products" class="btn-dark no-products-btn">View All Products</a>
            </div>

        <% } else { %>

            <!--
                ALL on-sale products are rendered into the DOM at once by EJS.
                jQuery will hide/show them in batches of 10 — no extra API calls.
            -->
            <div id="product-list" class="product-grid">
                <% products.forEach(product => { %>

                    <!--
                        Every card keeps the shared "product-card" class.
                        jQuery selects them with: $('#product-list .product-card')
                    -->
                    <div class="product-card">

                        <!-- Product Image -->
                        <div class="product-image">
                            <!-- Sale badge always shown on this page -->
                            <span class="badge on-sale">Sale</span>

                            <% if (product.stock === 0) { %>
                                <span class="badge sold-out">Sold out</span>
                            <% } %>

                            <a href="/products/<%= product._id %>">
                                <% if (product.image) { %>
                                    <% if (product.hoverImage) { %>
                                        <img src="<%= product.image %>"      alt="<%= product.name %>" class="img-default">
                                        <img src="<%= product.hoverImage %>" alt="<%= product.name %>" class="img-hover">
                                    <% } else { %>
                                        <img src="<%= product.image %>" alt="<%= product.name %>">
                                    <% } %>
                                <% } else { %>
                                    <div class="product-placeholder-text">
                                        <%= product.category.charAt(0) %>
                                    </div>
                                <% } %>
                            </a>
                        </div>

                        <!-- Product Info -->
                        <div class="product-info">
                            <span class="product-category-tag"><%= product.category %></span>

                            <h3 class="product-name">
                                <a href="/products/<%= product._id %>" style="color:inherit;text-decoration:none;">
                                    <%= product.name %>
                                </a>
                            </h3>

                            <!-- Star Rating -->
                            <div class="product-rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <span class="<%= i <= Math.round(product.rating) ? 'star filled' : 'star' %>">★</span>
                                <% } %>
                                <span class="rating-num">(<%= product.rating %>)</span>
                            </div>

                            <!-- Price —
                                 If salePrice exists: show original struck-through + red discounted price.
                                 Otherwise: fall back to the regular price (no strikethrough). -->
                            <div class="product-price">
                                <% if (product.salePrice) { %>
                                    <span class="price-was">Rs.<%= product.price.toLocaleString() %>.00</span>
                                    <span class="price-now">Rs.<%= product.salePrice.toLocaleString() %>.00 PKR</span>
                                <% } else { %>
                                    <span class="sale-price">Rs.<%= product.price.toLocaleString() %>.00 PKR</span>
                                <% } %>
                            </div>

                            <!-- Stock status -->
                            <div class="product-stock">
                                <% if (product.stock === 0) { %>
                                    <span class="out-of-stock">Out of Stock</span>
                                <% } else { %>
                                    <span class="in-stock">In Stock (<%= product.stock %>)</span>
                                <% } %>
                            </div>

                            <!-- Add to Cart / Qty Controls — mirrors the existing pages -->
                            <% if (product.stock > 0) { %>
                                <% const qtyInCart = cartMap[product._id.toString()] || 0; %>
                                <% if (qtyInCart > 0) { %>
                                    <div class="cart-qty-control">
                                        <form action="/cart/decrease/<%= product._id %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="redirectTo" value="/onsale-products">
                                            <button type="submit" class="qty-btn">&minus;</button>
                                        </form>
                                        <span class="qty-display"><%= qtyInCart %></span>
                                        <% if (qtyInCart < product.stock) { %>
                                            <form action="/cart/add/<%= product._id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="redirectTo" value="/onsale-products">
                                                <button type="submit" class="qty-btn">+</button>
                                            </form>
                                        <% } else { %>
                                            <button class="qty-btn" disabled title="Max stock reached">+</button>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <form action="/cart/add/<%= product._id %>" method="POST" style="margin:0;">
                                        <input type="hidden" name="redirectTo" value="/onsale-products">
                                        <button type="submit" class="btn-outline">Add to Cart</button>
                                    </form>
                                <% } %>
                            <% } else { %>
                                <button class="btn-outline" disabled>Sold Out</button>
                            <% } %>

                        </div>
                    </div>

                <% }) %>
            </div><!-- /#product-list -->

            <!--
                Pagination Controls
                jQuery controls visibility of these buttons and updates the indicator.
                Initial state is set by the jQuery script below — buttons are hidden
                via JS so they only show when there is more than one page.
            -->
            <div class="onsale-pagination" id="pagination-controls">
                <!-- Previous button — hidden on page 1 by jQuery -->
                <button class="page-btn" id="prev-btn">← Prev</button>

                <!-- Live page indicator — updated by jQuery on every click -->
                <span id="page-indicator">Page 1 of 1</span>

                <!-- Next button — hidden on last page by jQuery -->
                <button class="page-btn" id="next-btn">Next →</button>
            </div>

        <% } %>

    </div><!-- /.products-page-container -->

    <%- include('footer') %>

    <!-- Site-wide vanilla JS (menu toggle, search overlay, etc.) -->
    <script src="/js/script.js"></script>

    <!--
        jQuery CDN — loaded AFTER the product cards are in the DOM.
        Only this page uses jQuery; the rest of the site uses vanilla JS.
    -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    <script>
        /*
         * ============================================================
         *  CLIENT-SIDE JQUERY PAGINATION  —  /onsale-products
         * ============================================================
         *
         *  HOW IT WORKS:
         *  - EJS renders ALL on-sale products into #product-list at once.
         *  - This script hides all cards immediately, then reveals them
         *    10 at a time using jQuery .slice().show().
         *  - No server round-trips, no fetch(), no AJAX — pure DOM work.
         *
         *  DIFFERENCE vs. server-side pagination (used on /products):
         *  - Server-side  : each page click sends a new GET request to
         *    Express which queries MongoDB and re-renders the template.
         *  - Client-side  : all products are already in the HTML; jQuery
         *    just toggles visibility. Zero extra network requests.
         * ============================================================
         */
        $(document).ready(function () {

            var ITEMS_PER_PAGE = 10;   // number of product cards per page
            var currentPage    = 1;    // track which page the user is on

            // Cache the jQuery collection of ALL product cards once
            var $cards = $('#product-list .product-card');

            // Calculate total pages — Math.ceil so a partial last page counts
            var totalPages = Math.ceil($cards.length / ITEMS_PER_PAGE);

            /* ----------------------------------------------------------
             *  showPage(page)
             *  Hides all cards, then reveals only the 10 cards that
             *  belong to the requested page number.
             * ---------------------------------------------------------- */
            function showPage(page) {
                // 1. Hide every card first
                $cards.hide();

                // 2. Calculate the start and end index for this page
                var startIndex = (page - 1) * ITEMS_PER_PAGE;  // 0-based
                var endIndex   = startIndex + ITEMS_PER_PAGE;   // exclusive

                // 3. Slice and show only the cards for this page
                $cards.slice(startIndex, endIndex).show();

                // 4. Update the page indicator text
                $('#page-indicator').text('Page ' + page + ' of ' + totalPages);

                // 5. Show/hide Prev button — hide on first page
                if (page === 1) {
                    $('#prev-btn').hide();
                } else {
                    $('#prev-btn').show();
                }

                // 6. Show/hide Next button — hide on last page
                if (page === totalPages) {
                    $('#next-btn').hide();
                } else {
                    $('#next-btn').show();
                }
            }

            /* ----------------------------------------------------------
             *  Initial load — show page 1
             *  Also hide the whole pagination bar if only 1 page exists
             * ---------------------------------------------------------- */
            if (totalPages <= 1) {
                // If all products fit on one page, hide pagination entirely
                $('#pagination-controls').hide();
                $cards.show(); // make sure all cards are visible
            } else {
                showPage(currentPage); // sets up page 1 correctly
            }

            /* ----------------------------------------------------------
             *  NEXT BUTTON click handler
             * ---------------------------------------------------------- */
            $('#next-btn').on('click', function () {
                // Guard: do nothing if already on the last page
                if (currentPage < totalPages) {
                    currentPage++;       // move to next page
                    showPage(currentPage);
                }
            });

            /* ----------------------------------------------------------
             *  PREVIOUS BUTTON click handler
             * ---------------------------------------------------------- */
            $('#prev-btn').on('click', function () {
                // Guard: do nothing if already on the first page
                if (currentPage > 1) {
                    currentPage--;       // move to previous page
                    showPage(currentPage);
                }
            });

        }); // end document.ready
    </script>

</body>
</html>
