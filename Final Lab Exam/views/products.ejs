<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - Honey, I'm home Accessories.</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('header') %>

    <!-- Page Header -->
    <section class="page-header">
        <h2 class="page-title">All Products</h2>
        <p class="page-subtitle"><%= totalProducts %> item<%= totalProducts !== 1 ? 's' : '' %> found</p>
    </section>

    <div class="products-page-container">

        <!-- ===== Filter & Search Form ===== -->
        <!-- Using GET method so filters appear in the URL as query parameters -->
        <form class="filter-form" action="/products" method="GET">

            <!-- Search by name -->
            <div class="filter-group">
                <input
                    type="text"
                    name="search"
                    value="<%= search %>"
                    placeholder="Search by name..."
                    class="filter-input"
                >
            </div>

            <!-- Category dropdown -->
            <div class="filter-group">
                <select name="category" class="filter-select">
                    <option value="">All Categories</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>>
                            <%= cat %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Minimum price -->
            <div class="filter-group">
                <input
                    type="number"
                    name="minPrice"
                    value="<%= minPrice %>"
                    placeholder="Min Price (Rs.)"
                    class="filter-input"
                    min="0"
                >
            </div>

            <!-- Maximum price -->
            <div class="filter-group">
                <input
                    type="number"
                    name="maxPrice"
                    value="<%= maxPrice %>"
                    placeholder="Max Price (Rs.)"
                    class="filter-input"
                    min="0"
                >
            </div>

            <button type="submit" class="filter-btn">Apply Filters</button>
            <a href="/products" class="filter-clear-btn">Clear All</a>
        </form>

        <!-- ===== Product Grid ===== -->
        <% if (products.length === 0) { %>
            <!-- No results message -->
            <div class="no-products">
                <p>No products match your search. Try different filters.</p>
                <a href="/products" class="btn-dark no-products-btn">View All Products</a>
            </div>

        <% } else { %>

            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">

                        <!-- Product Image -->
                        <div class="product-image">
                            <% if (product.stock === 0) { %>
                                <span class="badge sold-out">Sold out</span>
                            <% } %>

                            <a href="/products/<%= product._id %>">
                            <% if (product.image) { %>
                                <% if (product.hoverImage) { %>
                                    <img src="<%= product.image %>"      alt="<%= product.name %>" class="img-default">
                                    <img src="<%= product.hoverImage %>" alt="<%= product.name %>" class="img-hover">
                                <% } else { %>
                                    <img src="<%= product.image %>" alt="<%= product.name %>">
                                <% } %>
                            <% } else { %>
                                <div class="product-placeholder-text">
                                    <%= product.category.charAt(0) %>
                                </div>
                            <% } %>
                            </a>
                        </div>

                        <!-- Product Info -->
                        <div class="product-info">
                            <span class="product-category-tag"><%= product.category %></span>

                            <h3 class="product-name">
                                <a href="/products/<%= product._id %>" style="color:inherit;text-decoration:none;">
                                    <%= product.name %>
                                </a>
                            </h3>

                            <!-- Star Rating -->
                            <div class="product-rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <span class="<%= i <= Math.round(product.rating) ? 'star filled' : 'star' %>">★</span>
                                <% } %>
                                <span class="rating-num">(<%= product.rating %>)</span>
                            </div>

                            <!-- Price: show struck-through original + red sale price if on sale -->
                            <div class="product-price">
                                <% if (product.isOnSale && product.salePrice) { %>
                                    <span style="text-decoration:line-through;color:#999;font-size:13px;margin-right:4px;">Rs.<%= product.price.toLocaleString() %>.00</span>
                                    <span style="color:#e53935;font-weight:700;">Rs.<%= product.salePrice.toLocaleString() %>.00 PKR</span>
                                <% } else { %>
                                    <span class="sale-price">Rs.<%= product.price.toLocaleString() %>.00 PKR</span>
                                <% } %>
                            </div>

                            <!-- Stock status -->
                            <div class="product-stock">
                                <% if (product.stock === 0) { %>
                                    <span class="out-of-stock">Out of Stock</span>
                                <% } else { %>
                                    <span class="in-stock">In Stock (<%= product.stock %>)</span>
                                <% } %>
                            </div>

                            <% if (product.stock > 0) { %>
                                <% const qtyInCart = cartMap[product._id.toString()] || 0; %>
                                <% if (qtyInCart > 0) { %>
                                    <div class="cart-qty-control">
                                        <form action="/cart/decrease/<%= product._id %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="redirectTo" value="/products">
                                            <button type="submit" class="qty-btn">&minus;</button>
                                        </form>
                                        <span class="qty-display"><%= qtyInCart %></span>
                                        <% if (qtyInCart < product.stock) { %>
                                            <form action="/cart/add/<%= product._id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="redirectTo" value="/products">
                                                <button type="submit" class="qty-btn">+</button>
                                            </form>
                                        <% } else { %>
                                            <button class="qty-btn" disabled title="Max stock reached">+</button>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <form action="/cart/add/<%= product._id %>" method="POST" style="margin:0;">
                                        <input type="hidden" name="redirectTo" value="/products">
                                        <button type="submit" class="btn-outline">Add to Cart</button>
                                    </form>
                                <% } %>
                            <% } else { %>
                                <button class="btn-outline" disabled>Sold Out</button>
                            <% } %>
                        </div>

                    </div>
                <% }) %>
            </div>

            <!-- ===== Pagination ===== -->
            <%
                // Build a base query string keeping all active filters
                // so pagination links don't lose the search/filter state
                const baseQuery = `search=${search}&category=${category}&minPrice=${minPrice}&maxPrice=${maxPrice}`;
            %>

            <% if (totalPages > 1) { %>
                <div class="pagination">

                    <!-- Previous Button -->
                    <% if (currentPage > 1) { %>
                        <a href="/products?page=<%= currentPage - 1 %>&<%= baseQuery %>" class="page-btn">← Prev</a>
                    <% } else { %>
                        <span class="page-btn disabled">← Prev</span>
                    <% } %>

                    <!-- Page Number Buttons -->
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="/products?page=<%= i %>&<%= baseQuery %>"
                           class="page-btn <%= currentPage === i ? 'active' : '' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <!-- Next Button -->
                    <% if (currentPage < totalPages) { %>
                        <a href="/products?page=<%= currentPage + 1 %>&<%= baseQuery %>" class="page-btn">Next →</a>
                    <% } else { %>
                        <span class="page-btn disabled">Next →</span>
                    <% } %>

                </div>

                <!-- Page info text -->
                <p class="pagination-info">
                    Page <%= currentPage %> of <%= totalPages %> &nbsp;|&nbsp; Showing <%= products.length %> of <%= totalProducts %> products
                </p>
            <% } %>

        <% } %>

    </div>

    <%- include('footer') %>

    <script src="/js/script.js"></script>
</body>
</html>
