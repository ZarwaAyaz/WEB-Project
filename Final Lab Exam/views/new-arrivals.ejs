<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Arrivals - Honey, I'm home Accessories.</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('header') %>

    <!-- Page Header -->
    <section class="page-header">
        <h2 class="page-title">NEW ARRIVALS</h2>
        <p class="page-subtitle">The latest additions to our collection &mdash; <%= products.length %> item<%= products.length !== 1 ? 's' : '' %></p>
    </section>

    <div class="products-page-container">
        <% if (products.length === 0) { %>
            <div class="no-products">
                <p>No new arrivals at the moment. Check back soon!</p>
                <a href="/products" class="btn-dark no-products-btn">View All Products</a>
            </div>
        <% } else { %>
            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div class="product-image">
                            <% if (product.stock === 0) { %>
                                <span class="badge sold-out">Sold out</span>
                            <% } %>
                            <% if (product.image) { %>
                                <% if (product.hoverImage) { %>
                                    <img src="<%= product.image %>" alt="<%= product.name %>" class="img-default">
                                    <img src="<%= product.hoverImage %>" alt="<%= product.name %>" class="img-hover">
                                <% } else { %>
                                    <img src="<%= product.image %>" alt="<%= product.name %>">
                                <% } %>
                            <% } else { %>
                                <div class="product-placeholder-text"><%= product.category.charAt(0) %></div>
                            <% } %>
                        </div>
                        <div class="product-info">
                            <span class="product-category-tag"><%= product.category %></span>
                            <h3 class="product-name"><%= product.name %></h3>
                            <div class="product-rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <span class="<%= i <= Math.round(product.rating) ? 'star filled' : 'star' %>">★</span>
                                <% } %>
                                <span class="rating-num">(<%= product.rating %>)</span>
                            </div>
                            <div class="product-price">
                                <% if (product.isOnSale && product.salePrice) { %>
                                    <span style="text-decoration:line-through;color:#999;font-size:13px;margin-right:4px;">Rs.<%= product.price.toLocaleString() %>.00</span>
                                    <span style="color:#e53935;font-weight:700;">Rs.<%= product.salePrice.toLocaleString() %>.00 PKR</span>
                                <% } else { %>
                                    <span class="sale-price">Rs.<%= product.price.toLocaleString() %>.00 PKR</span>
                                <% } %>
                            </div>
                            <div class="product-stock">
                                <% if (product.stock === 0) { %>
                                    <span class="out-of-stock">Out of Stock</span>
                                <% } else { %>
                                    <span class="in-stock">In Stock (<%= product.stock %>)</span>
                                <% } %>
                            </div>
                            <% if (product.stock > 0) { %>
                                <% const qtyInCart = cartMap[product._id.toString()] || 0; %>
                                <% if (qtyInCart > 0) { %>
                                    <div class="cart-qty-control">
                                        <form action="/cart/decrease/<%= product._id %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="redirectTo" value="/new-arrivals">
                                            <button type="submit" class="qty-btn">&minus;</button>
                                        </form>
                                        <span class="qty-display"><%= qtyInCart %></span>
                                        <% if (qtyInCart < product.stock) { %>
                                            <form action="/cart/add/<%= product._id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="redirectTo" value="/new-arrivals">
                                                <button type="submit" class="qty-btn">+</button>
                                            </form>
                                        <% } else { %>
                                            <button class="qty-btn" disabled title="Max stock reached">+</button>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <form action="/cart/add/<%= product._id %>" method="POST" style="margin:0;">
                                        <input type="hidden" name="redirectTo" value="/new-arrivals">
                                        <button type="submit" class="btn-outline">Add to cart</button>
                                    </form>
                                <% } %>
                            <% } else { %>
                                <button class="btn-outline" disabled>Sold Out</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <%- include('footer') %>

    <script src="/js/script.js"></script>
</body>
</html>
