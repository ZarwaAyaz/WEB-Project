<!-- Top Banner -->
<div class="top-banner">
    <p>Enjoy Free Delivery on orders above 5000 pkr.</p>
</div>

<!-- Navigation Bar -->
<nav class="navbar">
    <div class="nav-container">
        <div class="search-icon" id="searchToggle" title="Search products">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </div>

        <div class="logo">
            <h1>Honey, I'm home Accessories.</h1>
        </div>

        <div class="nav-icons">
            <div class="user-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <!-- Cart icon — links to /cart, shows item count badge -->
            <a href="/cart" class="cart-icon-link" title="View Cart">
                <div class="cart-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <% if (cartCount > 0) { %>
                        <span class="cart-badge"><%= cartCount %></span>
                    <% } %>
                </div>
            </a>
        </div>

        <button class="menu-toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="main-menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<!-- Main Menu -->
<div class="main-menu" id="main-menu">
    <ul>
        <li class="dropdown">
            <a href="/products">All Products ▼</a>
        </li>
        <li><a href="/new-arrivals">New Arrivals</a></li>
        <li><a href="/best-selling">Best Selling Items</a></li>
        <li><a href="/under-1000">✨ Under 1000 ✨</a></li>
        <li><a href="/onsale-products">🔥 On Sale</a></li>

        <%# Dynamic links based on login status — currentUser set via res.locals in app.js %>
        <% if (currentUser) { %>
            <%# Logged-in user: show My Profile and Logout %>
            <li><a href="/profile">👤 My Profile</a></li>
            <% if (currentUser.role === 'admin') { %>
                <%# Admin only: show Admin Panel link %>
                <li><a href="/admin" style="color:#c084a8; font-weight:600;">⚙️ Admin</a></li>
            <% } %>
            <li><a href="/logout">Logout</a></li>
        <% } else { %>
            <%# Guest: show Login and Register %>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
        <% } %>
    </ul>
</div>

<!-- Flash Messages — shown on every page, cleared after display -->
<% if (success && success.length > 0) { %>
    <div style="background:#e8f5e9; color:#2e7d32; border-bottom:1px solid #a5d6a7; padding:12px 24px; font-size:14px; text-align:center;">
        <%= success[0] %>
    </div>
<% } %>
<% if (error && error.length > 0) { %>
    <div style="background:#fde8e8; color:#c0392b; border-bottom:1px solid #f5b7b1; padding:12px 24px; font-size:14px; text-align:center;">
        <%= error[0] %>
    </div>
<% } %>

<!-- ===== Search Overlay (toggled by search icon) ===== -->
<div class="search-overlay" id="searchOverlay">
    <form class="search-overlay-form" action="/products" method="GET">
        <input
            type="text"
            name="search"
            id="searchInput"
            placeholder="Search for accessories..."
            class="search-overlay-input"
            autocomplete="off"
        >
        <button type="submit" class="search-overlay-btn">Search</button>
        <button type="button" class="search-overlay-close" id="searchClose">✕</button>
    </form>
</div>
