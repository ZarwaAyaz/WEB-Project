<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout – Honey, I'm home Accessories.</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('header') %>

    <section class="page-header">
        <h2 class="page-title">Checkout</h2>
        <p class="page-subtitle">Review your order before placing it</p>
    </section>

    <div class="checkout-container">

        <!-- Order Summary -->
        <div class="checkout-summary">
            <h3 class="checkout-section-title">Order Summary</h3>

            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                        <tr>
                            <td class="cart-product-cell">
                                <% if (item.image) { %>
                                    <img src="<%= item.image %>" alt="<%= item.name %>" class="cart-thumb">
                                <% } else { %>
                                    <div class="cart-thumb-placeholder"><%= item.name.charAt(0) %></div>
                                <% } %>
                                <span><%= item.name %></span>
                            </td>
                            <td>Rs. <%= item.price.toLocaleString() %></td>
                            <td><%= item.quantity %></td>
                            <td>Rs. <%= (item.price * item.quantity).toLocaleString() %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="cart-total" style="margin-top:16px;">
                Grand Total: <strong>Rs. <%= grandTotal.toLocaleString() %>.00 PKR</strong>
            </div>
        </div>

        <!-- Delivery Details Form -->
        <div class="checkout-actions">
            <h3 class="checkout-section-title">Delivery Details</h3>
            <form action="/checkout/place" method="POST">

                <!-- Name — auto-filled from session, user can edit -->
                <div style="margin-bottom:16px;">
                    <label for="customerName" style="display:block; font-weight:600; margin-bottom:6px;">👤 Full Name <span style="color:#c0392b;">*</span></label>
                    <input type="text" id="customerName" name="customerName" required
                        value="<%= currentUser.name %>"
                        placeholder="Your full name"
                        style="width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:6px; font-size:15px; outline:none; box-sizing:border-box;">
                </div>

                <!-- Phone -->
                <div style="margin-bottom:16px;">
                    <label for="phone" style="display:block; font-weight:600; margin-bottom:6px;">📞 Phone Number <span style="color:#c0392b;">*</span></label>
                    <input type="tel" id="phone" name="phone" required
                        placeholder="e.g. 0300-1234567"
                        pattern="[0-9\-\+\s]{7,15}"
                        style="width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:6px; font-size:15px; outline:none; box-sizing:border-box;">
                    <small style="color:#888;">We'll contact you on this number for delivery.</small>
                </div>

                <!-- Delivery Address -->
                <div style="margin-bottom:20px;">
                    <label for="address" style="display:block; font-weight:600; margin-bottom:6px;">📍 Delivery Address <span style="color:#c0392b;">*</span></label>
                    <textarea id="address" name="address" required rows="3"
                        placeholder="House/Flat No., Street, Area, City"
                        style="width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:6px; font-size:15px; outline:none; resize:vertical; box-sizing:border-box;"></textarea>
                </div>

                <button type="submit" class="btn-dark" style="padding:14px 36px; font-size:16px;">
                    ✅ Place Order
                </button>
            </form>
            <a href="/cart" class="btn-outline" style="display:inline-block; margin-top:12px;">← Back to Cart</a>
        </div>

    </div>

    <%- include('footer') %>
    <script src="/js/script.js"></script>
</body>
</html>
